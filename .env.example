# ---- xPay Commerce env ----
# Chain-parametrized x402 settlement. Default = Base Sepolia USDC (validated fail-open).
# Point CHAIN_ID/ASSET/RPC at BNB testnet ($U or USDT) for the Binance Agent OS lane.
XPAY_CHAIN_ID=84532
XPAY_ASSET=0x036CbD53842c5426634e7929541eC2318f3dCF7e
XPAY_DECIMALS=6
XPAY_RPC_URL=https://base-sepolia.publicnode.com
XPAY_PRICE_USDC=0.02
XPAY_TIMEOUT_S=300

# Seller key. If XPAY_PAY_TO is unset it derives from this.
XPAY_SELLER_KEY=
# Override payTo explicitly (optional).
XPAY_PAY_TO=

# Buyer key (exist: agent wallet / spend-capped signer).
XPAY_BUYER_KEY=

# ASP listen port.
XPAY_PORT=3000